<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.targetbridge.sender-reconnect</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>__HOME__/bin/targetbridge-sender-reconnect.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>5</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Application Support/targetbridge-sender-reconnect/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Application Support/targetbridge-sender-reconnect/launchd.err.log</string>
</dict>
</plist>
